{
  "opencollection": "1.0.0",
  "info": {
    "name": "Planable Public Campaigns Media API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Media",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List media uploads",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.planable.io/api/v1/media",
            "params": [
              {
                "name": "workspaceId",
                "value": "",
                "type": "query"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns media uploads for a workspace with pagination."
        },
        {
          "info": {
            "name": "Upload media from URLs",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.planable.io/api/v1/media",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Accepts 1 to 20 public image or video URLs (each max 100MB) for async download and processing. Returns 202 immediately with processing status for each item."
        },
        {
          "info": {
            "name": "Get media upload",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.planable.io/api/v1/media/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a single media upload by ID."
        }
      ]
    }
  ],
  "bundled": true
}