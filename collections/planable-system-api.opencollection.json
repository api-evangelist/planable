{
  "opencollection": "1.0.0",
  "info": {
    "name": "Planable Public Campaigns System API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "System",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Health check",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.planable.io/api/v1/ping",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns 200 if the token is valid and has the read scope."
        }
      ]
    }
  ],
  "bundled": true
}